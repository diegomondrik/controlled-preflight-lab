{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ingol/stage-b/evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","case_id","classification","repository","base_sha","candidate_sha","runs","checks","records","limitations"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "case_id": {"type":"string","pattern":"^B-(0[1-9]|1[01])$"},
    "classification": {"enum":["passed","failed","inconclusive","not_executed"]},
    "repository": {"type":"string","pattern":"^[^/]+/[^/]+$"},
    "base_sha": {"$ref":"#/$defs/commit"},
    "candidate_sha": {"$ref":"#/$defs/commit"},
    "runs": {"type":"array","items":{"$ref":"#/$defs/identity"}},
    "checks": {"type":"array","items":{"$ref":"#/$defs/identity"}},
    "records": {"type":"array","items":{"$ref":"#/$defs/record"}},
    "limitations": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  },
  "$defs": {
    "commit": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "identity": {
      "type":"object","additionalProperties":false,
      "required":["kind","id","attempt","path","head_sha"],
      "properties":{"kind":{"type":"string"},"id":{"type":"integer","minimum":1},"attempt":{"type":"integer","minimum":1},"path":{"type":"string"},"head_sha":{"$ref":"#/$defs/commit"}}
    },
    "record": {
      "type":"object","additionalProperties":false,
      "required":["path","bytes","sha256","observed_at"],
      "properties":{"path":{"type":"string"},"bytes":{"type":"integer","minimum":1},"sha256":{"$ref":"#/$defs/sha256"},"observed_at":{"type":"string","format":"date-time"}}
    }
  }
}

