{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ingol/stage-b/black-box-protocol-v1.json",
  "title": "WI-R01 Stage B black-box protocol",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "case_id", "operation"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "case_id": {"type": "string", "pattern": "^B-(0[1-9]|1[01])$"},
        "operation": {"const": "evaluate_evidence_disposition"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "disposition"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "disposition": {"type": "string", "maxLength": 64}
      }
    }
  ]
}

